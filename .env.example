# =============================================
# Supabase (WAJIB)
# =============================================
# URL project Supabase. Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL="https://<your-project-ref>.supabase.co"

# Publishable / anon key. Settings -> API -> Project API keys -> Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx..."

# =============================================
# Supabase (SERVER-ONLY, JANGAN NEXT_PUBLIC_*)
# =============================================
# Service role / secret key. Settings -> API -> Project API keys -> Secret key
# Dipakai Server Action via lib/supabase.ts (getSupabaseAdminClient) untuk bypass RLS
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx..."

# =============================================
# Map / Tile Provider (OPSIONAL tapi direkomendasikan)
# =============================================
# API key CARTO basemaps untuk tile Leaflet. Daftar di https://carto.com/
# Jika kosong, tile tetap dimuat tanpa api_key (untuk dev), tapi bisa kena rate-limit
NEXT_PUBLIC_CARTO_API_KEY=""
